<div id="<%= dom_id ingredient %>">
  <p class="my-5">
    <strong class="block font-medium mb-1">Name:</strong>
    <%= ingredient.name %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">Quantity:</strong>
    <%= ingredient.quantity %>
  </p>

  <% if ingredient.photo.attached? %>
    <div class="my-5">
      <strong class="block font-medium mb-1">Photo:</strong>
      <%= image_tag ingredient.photo, alt: "Photo of #{ingredient.name}", class: "max-w-xs rounded-lg" %>
    </div>
  <% end %>

  <% if action_name != "show" %>
    <%= link_to "Show this ingredient", ingredient, class: "rounded-lg py-3 px-5 bg-gray-100 inline-block font-medium" %>
    <%= link_to 'Edit this ingredient', edit_ingredient_path(ingredient), class: "rounded-lg py-3 ml-2 px-5 bg-gray-100 inline-block font-medium" %>
    <hr class="mt-6">
  <% end %>
</div>
